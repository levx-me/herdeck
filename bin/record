#!/usr/bin/env bash
# Claude Code PostToolUse / PostToolUseFailure hook (Bash): after the agent ran
# a command, record it in the deck when it holds a test run, a build or git.
#
# Plain tests and builds were already rewritten to bin/run and recorded live.
# This catches the rest after the fact: tests and builds inside chains or pipes
# (`git status; forge test 2>&1 | grep FAIL`), and every git command. Nothing
# here changes the command, so Claude's own permission checks stay in place.
set -u

input=$(cat)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
[ -n "$cmd" ] || exit 0
case $cmd in *"/bin/run\" "*) exit 0 ;; esac # routed through bin/run: already recorded

# A runner at the start of the command or of any step in a chain, pipe or subshell.
step='(^|[;&|(]|&&|\|\|)[[:space:]]*(cd [^;&|]+ && )?([A-Za-z_][A-Za-z0-9_]*=[^ ]* )*(npx |pnpm (exec |dlx )?|yarn |bunx |uv run |poetry run |python3? -m )?'
tests='(vitest|jest|pytest|cargo test|cargo nextest run|go test|bun test|deno test|forge test|npm (run )?test|pnpm (run )?test|yarn (run )?test|bun run test)([[:space:]]|$|\))'
builds='(forge build|cargo build|cargo check|go build|tsc|next build|vite build|npm run build|pnpm (run )?build|yarn (run )?build|bun run build|swift build)([[:space:]]|$|\))'
if [[ $cmd =~ ${step}${tests} ]]; then kind=test
elif [[ $cmd =~ ${step}${builds} ]]; then kind=build
elif [[ $cmd =~ ${step}git[[:space:]] ]]; then kind=git
else exit 0
fi

root=$(cd "$(dirname "$0")/.." && pwd)
dir="${TMPDIR:-/tmp}/herdeck/$(printf '%s' "$HERDR_PANE_ID" | tr ':/' '__')/$kind"
mkdir -p "$dir/runs"

keep=20; [ "$kind" = git ] && keep=50
n=$(ls "$dir/runs" | sort -n | tail -1); n=$(( ${n:-0} + 1 ))
ls "$dir/runs" | sort -rn | tail -n +"$keep" | while read -r old; do rm -rf "${dir:?}/runs/$old"; done
r="$dir/runs/$n"
mkdir -p "$r"

printf '%s\n' "$cmd" > "$r/cmd"
printf '%s' "$input" | jq -r '.cwd // empty' > "$r/cwd"
end=$(date +%s)
ms=$(printf '%s' "$input" | jq -r '.duration_ms // 0 | floor')
printf '%s\n' "$(( end - ms / 1000 ))" > "$r/start"

if [ "$(printf '%s' "$input" | jq -r .hook_event_name)" = PostToolUseFailure ]; then
  # "Exit code N" on the first line, then the combined output.
  err=$(printf '%s' "$input" | jq -r '.error // ""')
  rc=$(printf '%s\n' "$err" | sed -n '1s/^Exit code \([0-9][0-9]*\).*/\1/p')
  printf '%s\n' "$err" | sed '1{/^Exit code [0-9]*$/d;}' > "$r/log"
  printf '%s\n' "${rc:-1}" > "$r/rc"
else
  printf '%s' "$input" | jq -r '[.tool_response.stdout // "", .tool_response.stderr // ""] | map(select(. != "")) | join("\n")' > "$r/log"
  printf '0\n' > "$r/rc"
fi
printf '%s\n' "$end" > "$r/end"

# Open (or reuse) the deck on that section without holding up the agent.
cwd=$(cat "$r/cwd")
(cd "${cwd:-$PWD}" 2>/dev/null && "$root/bin/pane" "$kind" >/dev/null 2>&1 &)
exit 0
