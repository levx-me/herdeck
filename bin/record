#!/usr/bin/env bash
# Claude Code PostToolUse / PostToolUseFailure hook (Bash): after the agent ran
# a command, record it in the deck when it holds a test run, a build, git or a deploy.
#
# Plain tests and builds were already rewritten to bin/run and recorded live.
# This catches the rest after the fact: tests and builds inside chains or pipes
# (`git status; forge test 2>&1 | grep FAIL`), and every git command. Nothing
# here changes the command, so Claude's own permission checks stay in place.
set -u

input=$(cat)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
[ -n "$cmd" ] || exit 0
case $cmd in *"/bin/run\" "*) exit 0 ;; esac # routed through bin/run: already recorded

# A runner at the start of the command or of any step in a chain, pipe or subshell.
. "$(dirname "$0")/runners.sh"
step="(^|[;&|(]|&&|\\|\\|)[[:space:]]*(cd [^;&|]+ && )?([A-Za-z_][A-Za-z0-9_]*=[^ ]* )*${wrappers}${launchers}"
end='([[:space:]]|$|\))'

# Only look at what the shell would run: drop heredoc bodies and quoted strings,
# so `grep 'forge test' notes` or a script mentioning a runner is not a run.
scan=$(printf '%s' "${cmd%%<<*}" | perl -0pe "s/'[^']*'//g; s/\"[^\"]*\"//g")
# The session note asks for Bash descriptions like "build: ./build.sh"; when the
# agent gives one, it names the section and labels the run.
desc=$(printf '%s' "$input" | jq -r '.tool_input.description // empty')
label=""
if [[ $desc =~ ^(test|build|git|deploy):[[:space:]]*(.+)$ ]]; then kind=${BASH_REMATCH[1]} label=${BASH_REMATCH[2]}
elif [[ $scan =~ ${step}${tests}${end} ]]; then kind=test
elif [[ $scan =~ ${step}${builds}${end} ]]; then kind=build
elif [[ $scan =~ ${step}${deploys}${end} ]]; then kind=deploy
elif [[ $scan =~ ${step}git[[:space:]] ]]; then kind=git
else exit 0
fi

root=$(cd "$(dirname "$0")/.." && pwd)
dir="${TMPDIR:-/tmp}/herdeck/$(printf '%s' "$HERDR_PANE_ID" | tr ':/' '__')/$kind"
mkdir -p "$dir/runs"

keep=20; [ "$kind" = git ] && keep=50
n=$(ls "$dir/runs" | sort -n | tail -1); n=$(( ${n:-0} + 1 ))
ls "$dir/runs" | sort -rn | tail -n +"$keep" | while read -r old; do rm -rf "${dir:?}/runs/$old"; done
r="$dir/runs/$n"
mkdir -p "$r"

printf '%s\n' "$cmd" > "$r/cmd"
[ -n "$label" ] && printf '%s\n' "$label" > "$r/label"
printf '%s' "$input" | jq -r '.cwd // empty' > "$r/cwd"
end=$(date +%s)
ms=$(printf '%s' "$input" | jq -r '.duration_ms // 0 | floor')
printf '%s\n' "$(( end - ms / 1000 ))" > "$r/start"

bg=$(printf '%s' "$input" | jq -r '.tool_response.backgroundTaskId // empty')
if [ -n "$bg" ]; then
  # Sent to the background: this hook fires at launch, not at the end. Point the
  # deck at Claude's task output file instead; it follows it and reads the
  # "[exited with code N]" line Claude Code appends when the command ends.
  out=$(find "/private/tmp/claude-$(id -u)" "${TMPDIR:-/tmp}/claude-$(id -u)" -maxdepth 4 \
    -name "$bg.output" -print -quit 2>/dev/null)
  printf '%s\n' "${out:-}" > "$r/source"
  [ -n "$out" ] || printf '(running in the background as %s; output not found)\n' "$bg" > "$r/log"
elif [ "$(printf '%s' "$input" | jq -r .hook_event_name)" = PostToolUseFailure ]; then
  # "Exit code N" on the first line, then the combined output.
  err=$(printf '%s' "$input" | jq -r '.error // ""')
  rc=$(printf '%s\n' "$err" | sed -n '1s/^Exit code \([0-9][0-9]*\).*/\1/p')
  printf '%s\n' "$err" | sed '1{/^Exit code [0-9]*$/d;}' > "$r/log"
  printf '%s\n' "${rc:-1}" > "$r/rc"
else
  printf '%s' "$input" | jq -r '[.tool_response.stdout // "", .tool_response.stderr // ""] | map(select(. != "")) | join("\n")' > "$r/log"
  printf '0\n' > "$r/rc"
fi
[ -n "$bg" ] || printf '%s\n' "$end" > "$r/end"

# Open (or reuse) the deck on that section without holding up the agent.
cwd=$(cat "$r/cwd")
(cd "${cwd:-$PWD}" 2>/dev/null && "$root/bin/pane" "$kind" >/dev/null 2>&1 &)
exit 0
