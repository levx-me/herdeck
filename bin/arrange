#!/usr/bin/env python3
"""Arrange the agent's viewer column: servers on top, build under it, test below
taking the rest of the height. Servers and build get a fixed number of rows.

    arrange             (agent = $HERDR_PANE_ID)

Viewer pane ids come from $TMPDIR/herdeck/<agent>/<kind>/pane. The column
is the chain of "down" splits bin/pane builds; panes are swapped into order and
the split ratios set through herdr's socket API.
"""
import json
import os
import socket
import subprocess

ORDER = ["servers", "build", "test"]   # top to bottom
ROWS = {"servers": 6, "build": 9}      # fixed heights; test takes what is left

agent = os.environ["HERDR_PANE_ID"]
base = os.path.join(os.environ.get("TMPDIR", "/tmp"), "herdeck", agent.replace(":", "_").replace("/", "_"))


def call(method, params):
    s = socket.socket(socket.AF_UNIX)
    s.connect(os.environ["HERDR_SOCKET_PATH"])
    s.sendall((json.dumps({"id": "arrange", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf).get("result", {})


def panes(node):
    if node["type"] == "pane":
        return [node["pane_id"]]
    return panes(node["first"]) + panes(node["second"])


def find(node, wanted, path=()):
    """Path to the smallest split holding exactly the wanted panes."""
    if node["type"] != "split":
        return None
    if set(panes(node)) == wanted:
        return list(path)
    return find(node["first"], wanted, path + (False,)) or find(node["second"], wanted, path + (True,))


def main():
    viewers = {}
    for kind in ORDER:
        try:
            with open(os.path.join(base, kind, "pane")) as f:
                viewers[kind] = f.read().strip()
        except OSError:
            pass
    root = call("layout.export", {"pane_id": agent})["layout"]["root"]
    present = set(panes(root))
    viewers = {k: p for k, p in viewers.items() if p in present}
    if len(viewers) < 2:
        return
    path = find(root, set(viewers.values()))
    if path is None:  # not a clean column of viewers: leave it alone
        return

    # Swap panes until the column reads servers, build, test from the top.
    want = [viewers[k] for k in ORDER if k in viewers]
    for i, pane in enumerate(want):
        node = root
        for step in path:
            node = node["second"] if step else node["first"]
        current = panes(node)
        if current[i] != pane:
            subprocess.run(["herdr", "pane", "swap", "--source-pane", current[i], "--target-pane", pane],
                           capture_output=True)
            root = call("layout.export", {"pane_id": agent})["layout"]["root"]

    # Heights: walk the chain of down splits, giving each fixed pane its rows.
    rects = {p["pane_id"]: p["rect"] for p in call("pane.layout", {"pane_id": agent})["layout"]["panes"]}
    height = sum(rects[p]["height"] for p in want)
    kinds = [k for k in ORDER if k in viewers]
    step = list(path)
    for kind in kinds[:-1]:
        rows = ROWS.get(kind, height // 2)
        ratio = max(0.05, min(0.95, rows / height))
        call("layout.set_split_ratio", {"pane_id": agent, "path": step, "ratio": ratio})
        height -= rows
        step = step + [True]


if __name__ == "__main__":
    main()
