#!/usr/bin/env bash
# Claude Code PreToolUse hook (Bash): when the agent runs a test or build inside
# herdr, rewrite the call so it runs through bin/run, which streams it into a
# read-only deck pane beside the agent and hands the output back.
#
# Only a plain invocation is rewritten:
#   [cd DIR &&] [VAR=val ...] [time|nice|timeout N|env ...] [npx|pnpm|... ] RUNNER [args]
#   (RUNNER per bin/runners.sh: tool runners, make/just targets, ./build.sh, ./test.sh ...)
#   optionally followed by `2>&1` and one `| tail/head -n N` filter.
# Anything with other pipes, chains, substitutions or redirects is left alone,
# so "allow" below never approves more than a test or build.
set -u

input=$(cat)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')
[ -n "$cmd" ] || exit 0

# Starting a dev server: leave the command alone, just bring up the servers section.
devs='(^|[;&|(] *)(npx |pnpm (exec |dlx )?|yarn |bunx )?((npm|pnpm|yarn|bun) (run )?(dev|start|serve|preview)|next (dev|start)|vite( |$)|astro dev|nuxt dev|remix dev|wrangler dev|python3? -m http\.server|uvicorn |flask run|rails (s|server)|anvil( |$)|php artisan serve)'
if [[ $cmd =~ $devs ]]; then
  cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
  (cd "${cwd:-$PWD}" && "$CLAUDE_PLUGIN_ROOT/bin/pane" servers >/dev/null 2>&1 &)
  exit 0
fi

safe='[^;&|`$<>()]'
. "$(dirname "$0")/runners.sh"
prefix="^(cd ${safe}+ && )?([A-Za-z_][A-Za-z0-9_]*=${safe}* )*${wrappers}${launchers}"
filter=' \| (tail|head)( -n)? -?[0-9]+$'

core=$cmd post=""
if [[ $core =~ $filter ]]; then
  post=${BASH_REMATCH[0]# | }
  core=${core%"${BASH_REMATCH[0]}"}
fi
core=${core% 2>&1}

if [[ $core =~ ${prefix}${tests}( ${safe}*)?$ ]]; then kind=test
elif [[ $core =~ ${prefix}${builds}( ${safe}*)?$ ]]; then kind=build
else exit 0
fi

b64() { printf '%s' "$1" | base64 | tr -d '\n'; }
wrapped="\"$CLAUDE_PLUGIN_ROOT/bin/run\" $kind $(b64 "$core") $(b64 "$post")"

printf '%s' "$input" | jq --arg c "$wrapped" --arg k "$kind" '{
  hookSpecificOutput: {
    hookEventName: "PreToolUse",
    permissionDecision: "allow",
    permissionDecisionReason: ("\($k) run shown in the Herdeck deck"),
    updatedInput: (.tool_input + {command: $c})
  }
}'
