#!/usr/bin/env bash
# Claude Code SessionStart hook, inside herdr only:
#  - tells the agent how to run tests and builds so the deck can stream them
#    (every start, resume, /clear and compaction, so the note never drops out);
#  - opens the deck beside the agent when a session starts or resumes.
set -u
input=$(cat)
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
[ -n "$(printf '%s' "$input" | jq -r '.agent_id // empty')" ] && exit 0 # not for subagents

case $(printf '%s' "$input" | jq -r '.source // empty') in
  startup | resume | "")
    cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
    # In the background: the session should not wait for the pane to come up.
    (cd "${cwd:-$PWD}" 2>/dev/null && "$(dirname "$0")/pane" >/dev/null 2>&1 &)
    ;;
esac

note="Herdeck shows this session's tests, builds and git commands live in a herdr pane beside you. \
Run tests and builds as plain commands (\`forge test\`, \`npm test\`, \`./build.sh\`), not piped through \
grep/head/sed, redirected to a file, or chained with other commands: Herdeck then streams them with colour \
and still returns the full output and exit code to you. Append \`| tail -n N\` if you only need the end. \
Keep them in the foreground unless a run takes many minutes. \
You MUST give every test, build, git or deploy (vercel, railway) Bash call a description of the form \
\`<kind>: <core command>\`, e.g. \`test: forge test --match-path 'test/*'\`, \`build: pnpm build\`, \
\`git: git commit && git push\`, \`deploy: vercel --prod\` (kind is test, build, git or deploy), even when the \
command also does other things: Herdeck files the run under that kind and shows that line instead of the raw command."
jq -n --arg note "$note" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $note}}'
