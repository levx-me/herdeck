#!/usr/bin/env bash
# Make sure the agent has its Steading deck: one viewer pane split off to the
# right, with agents, jobs, servers, build, test, git and deploy sections. Prints the pane id.
#
#   pane [--follow] [SECTION] [CWD]
#                           SECTION (agents|jobs|servers|build|test|git|deploy) is brought forward;
#                           CWD (default $PWD) picks the project for servers.
#                           --follow: only switch an open deck, never open one (runs use it;
#                           the deck opens from prefix+d or when an agent starts).
set -u
follow=
[ "${1:-}" = --follow ] && { follow=1; shift; }
section=${1:-}
cwd=${2:-$PWD}
agent=${HERDR_PANE_ID:?not inside a herdr pane}
root=$(cd "$(dirname "$0")/.." && pwd)

base="${TMPDIR:-/tmp}/steading/$(printf '%s' "$agent" | tr ':/' '__')"
mkdir -p "$base"
# Project root, for the servers section.
git -C "$cwd" rev-parse --show-toplevel 2>/dev/null > "$base/root" || printf '%s\n' "$cwd" > "$base/root"
[ -n "$section" ] && printf '%s\n' "$section" > "$base/focus"

pane=$(cat "$base/pane" 2>/dev/null)
if [ -n "$pane" ] && herdr pane get "$pane" >/dev/null 2>&1; then
  printf '%s\n' "$pane"
  exit 0
fi
[ -n "$follow" ] && exit 0

# herdr starts the deck straight in a split (the plugin's "deck" pane), so no
# shell shows first and nothing a shell might ask at startup gets in the way.
pane=$(herdr plugin pane open --plugin steading --entrypoint deck --placement split --target-pane "$agent" \
  --direction right --env "STEADING_BASE=$base" --no-focus 2>/dev/null |
  jq -r '.result.plugin_pane.pane.pane_id // empty')
if [ -n "$pane" ]; then
  # Plugin panes split in half; give the agent 60%.
  python3 -I - "$agent" "$pane" <<'PY' 2>/dev/null
import json, os, socket, sys
agent, deck = sys.argv[1:]
def call(method, params):
    s = socket.socket(socket.AF_UNIX); s.connect(os.environ["HERDR_SOCKET_PATH"])
    s.sendall((json.dumps({"id": "steading", "method": method, "params": params}) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        buf += s.recv(65536)
    return json.loads(buf).get("result", {})
def find(node, path=()):
    if node["type"] == "split":
        a, b = node["first"], node["second"]
        if a.get("pane_id") == agent and b.get("pane_id") == deck:
            return list(path)
        return find(a, path + (False,)) or find(b, path + (True,))
root = call("layout.export", {"pane_id": agent})["layout"]["root"]
path = find(root)
if path is not None:
    call("layout.set_split_ratio", {"pane_id": agent, "path": path, "ratio": 0.6})
PY
else
  # The herdr plugin is not installed (only the Claude Code side): split a shell
  # and start the deck in it.
  pane=$(herdr pane split --pane "$agent" --direction right --ratio 0.6 --cwd "$cwd" --no-focus |
    jq -r '.result.pane.pane_id // empty')
  [ -n "$pane" ] || exit 1
  herdr pane rename "$pane" "Steading" >/dev/null 2>&1
  sleep 0.4 # let the new shell reach its prompt
  # exec: the deck replaces the shell, so quitting it closes the pane.
  herdr pane run "$pane" "exec python3 $(printf '%q' "$root/bin/viewer.py") $(printf '%q' "$base")" >/dev/null
fi
printf '%s' "$pane" > "$base/pane"
printf '%s\n' "$pane"
