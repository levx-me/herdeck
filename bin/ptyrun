#!/usr/bin/env python3
"""Run a command on a pseudo-terminal and append everything it prints to LOG.

    ptyrun LOG COMMAND [ARG ...]

Runners colour their output only when it goes to a terminal, so the deck gets
what you would see in a shell. stdin stays /dev/null so nothing waits for input.
Exits with the command's code (128 + n when killed by signal n).
"""
import fcntl
import os
import pty
import select
import struct
import subprocess
import sys
import termios

log, argv = sys.argv[1], sys.argv[2:]
master, slave = pty.openpty()
fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 50, 120, 0, 0))
proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=slave, stderr=slave)
os.close(slave)

with open(log, "ab") as out:
    while True:
        ready = select.select([master], [], [], 0.2)[0]
        if ready:
            try:
                data = os.read(master, 65536)
            except OSError:  # EIO: every writer has closed the terminal
                break
            if not data:
                break
            out.write(data)
            out.flush()
        elif proc.poll() is not None:
            break  # done, even if a background child still holds the terminal

code = proc.wait()
sys.exit(128 - code if code < 0 else code)
