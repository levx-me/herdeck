#!/bin/sh
# Install the Claude Code half (the PreToolUse hook) when Claude Code is present.
# Runs as herdr's [[build]] step and from the "install-claude" action.
# Never fails the herdr install: no Claude Code just means nothing to do.
#
# The marketplace is the GitHub repo, not this checkout: herdr may build in one
# place and move the plugin afterwards, which would strand a local path.
# Override with STEADING_SOURCE (a path or owner/repo) for local work.

source="${STEADING_SOURCE:-levx-me/steading}"

if ! command -v claude >/dev/null 2>&1; then
  echo "steading: Claude Code not found, skipping its hook (rerun the install-claude action after installing it)"
  exit 0
fi

if claude plugin list 2>/dev/null | grep -q 'steading@steading'; then
  claude plugin marketplace update steading >/dev/null 2>&1
  claude plugin update steading@steading >/dev/null 2>&1
  echo "steading: Claude Code hook already installed, updated"
  exit 0
fi

if claude plugin marketplace add "$source" >/dev/null 2>&1 &&
   claude plugin install steading@steading >/dev/null 2>&1; then
  echo "steading: Claude Code hook installed — run /reload-plugins in open Claude sessions"
else
  echo "steading: could not install the Claude Code hook; run: claude plugin marketplace add $source && claude plugin install steading@steading"
fi
exit 0
